<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <AutoCADManagedDir>C:\Program Files\Autodesk\AutoCAD 2019</AutoCADManagedDir>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCADManagedDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCADManagedDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCADManagedDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="rules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="columns.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
